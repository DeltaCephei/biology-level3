              <!-- Sun -->
              <circle cx="120" cy="180" r="42" fill="var(--accent)" opacity="0.18"/>
              <circle cx="120" cy="180" r="28" fill="var(--accent)" opacity="0.5"/>
              <text x="120" y="184" text-anchor="middle" fill="var(--surface-0)" font-size="13" font-weight="700" font-family="'Space Grotesk', sans-serif">Sun</text>

              <!-- Earth orbit ellipse -->
              <ellipse cx="120" cy="180" rx="240" ry="115" fill="none" stroke="var(--standard-3-colour)" stroke-width="1.2" stroke-dasharray="3 4" opacity="0.55"/>

              <!-- Earth -->
              <g>
                <circle cx="360" cy="180" r="34" fill="var(--info)" opacity="0.18"/>
                <circle cx="360" cy="180" r="22" fill="var(--info)" opacity="0.8"/>
                <!-- Axis tilt -->
                <line x1="345" y1="148" x2="375" y2="212" stroke="var(--text-primary)" stroke-width="1.2" opacity="0.6"/>
                <text x="360" y="184" text-anchor="middle" fill="var(--surface-0)" font-size="12" font-weight="700" font-family="'Space Grotesk', sans-serif">Earth</text>
                <!-- Rotation arrow -->
                <path d="M385 156 a26 26 0 1 1 -8 -22" fill="none" stroke="var(--accent)" stroke-width="1.5" opacity="0.8"/>
                <polygon points="380,134 388,138 382,144" fill="var(--accent)" opacity="0.8"/>
              </g>

              <!-- Moon orbit ellipse -->
              <ellipse cx="360" cy="180" rx="70" ry="38" fill="none" stroke="var(--fluoro-pink, #ff6ec7)" stroke-width="1.1" stroke-dasharray="3 3" opacity="0.55"/>

              <!-- Moon -->
              <g>
                <circle cx="430" cy="180" r="11" fill="var(--text-secondary)" opacity="0.85"/>
                <text x="430" y="158" text-anchor="middle" fill="var(--text-secondary)" font-size="10" font-family="'Inter', sans-serif">Moon</text>
