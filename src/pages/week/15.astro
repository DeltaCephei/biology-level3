        <!-- Key vocab -->
        <div class="sidebar-card fade-in-up">
          <h3>Key Vocabulary</h3>
          <dl class="vocab-list">
            <dt>Endogenous</dt><dd>Originating inside the organism. Persists when external cues are removed.</dd>
            <dt>Exogenous</dt><dd>Coming from outside the organism.</dd>
            <dt>Zeitgeber</dt><dd>External cue that entrains an endogenous rhythm.</dd>
            <dt>Entrainment</dt><dd>The process of a zeitgeber synchronising an internal clock to the environment.</dd>
            <dt>Free-running</dt><dd>The period a rhythm settles into when all zeitgebers are removed.</dd>
            <dt>SCN</dt><dd>Suprachiasmatic nucleus &mdash; the master circadian clock in the mammalian hypothalamus.</dd>
            <dt>Melatonin</dt><dd>Pineal-gland hormone, high at night, low by day; signals night to the body.</dd>
          </dl>
