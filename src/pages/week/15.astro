                <text x="565" y="280" fill="var(--text-secondary)" font-size="11" font-family="'Inter', sans-serif">Period: ~365.25 days</text>
                <text x="565" y="296" fill="var(--text-secondary)" font-size="11" font-family="'Inter', sans-serif">Photoperiod and temperature change</text>
