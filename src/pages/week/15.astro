      color: var(--text-primary);
      margin-top: var(--space-6);
      margin-bottom: var(--space-3);
    }
    .content-section h4 {
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      color: var(--text-primary);
      margin-top: var(--space-5);
      margin-bottom: var(--space-3);
    }
    .section-intro {
      font-size: var(--text-base);
      color: var(--text-secondary);
      margin-bottom: var(--space-5);
      line-height: var(--leading-relaxed);
    }
    .content-section p {
      font-size: var(--text-base);
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-4);
    }
    .content-section ul,
    .content-section ol {
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-4);
      padding-left: var(--space-5);
    }
    .content-section li { margin-bottom: var(--space-2); }
    .content-section a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px dotted var(--accent);
      transition: opacity var(--transition-fast);
    }
    .content-section a:hover { opacity: 0.75; }

    /* ── Lesson Inline Nav ── */
    .lesson-inline-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-5);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--border-subtle);
    }
    .lesson-inline-nav__current {
      font-size: var(--text-xs);
      font-family: var(--font-mono);
      color: var(--text-muted);
    }
    .lesson-inline-nav__link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      color: var(--standard-3-colour, var(--accent));
      text-decoration: none;
      transition: opacity var(--transition-fast);
      border-bottom: none;
    }
    .lesson-inline-nav__link:hover { opacity: 0.8; }

    /* ── Key concept boxes ── */
    .key-concept {
      background: var(--surface-2);
      border: 1px solid var(--standard-3-colour, var(--accent));
      border-left: 4px solid var(--standard-3-colour, var(--accent));
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      margin: var(--space-5) 0;
    }
    .key-concept h4 {
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      color: var(--standard-3-colour, var(--accent));
      margin-bottom: var(--space-3);
      margin-top: 0;
    }
    .key-concept--quote .exam-sentence {
      font-size: var(--text-lg);
      color: var(--text-primary);
      font-family: var(--font-display);
      line-height: var(--leading-tight);
      margin-bottom: var(--space-4);
    }

    /* ── Exam tip box ── */
    .exam-tip {
      background: rgba(255, 214, 0, 0.06);
      border-left: 4px solid var(--warning);
      border-radius: var(--radius-md);
      padding: var(--space-4) var(--space-5);
      margin: var(--space-5) 0;
    }
    .exam-tip h4 {
      color: var(--warning);
      margin-top: 0;
      margin-bottom: var(--space-2);
    }

    /* ── Diagram wrapper ── */
    .pathway-diagram {
      background: var(--surface-2);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-4);
      margin: var(--space-5) 0;
      overflow-x: auto;
    }
    .pathway-svg {
      width: 100%;
      height: auto;
      display: block;
    }

    /* ── Rhythm table ── */
    .rhythm-table-wrap { overflow-x: auto; margin: var(--space-4) 0; }
    .rhythm-table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--text-sm);
      background: var(--surface-2);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .rhythm-table th,
    .rhythm-table td {
      text-align: left;
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--border-subtle);
      vertical-align: top;
      color: var(--text-secondary);
    }
    .rhythm-table th {
      background: var(--surface-3);
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: var(--weight-semibold);
      text-transform: uppercase;
      font-size: var(--text-xs);
      letter-spacing: 0.05em;
    }
    .rhythm-table tr:last-child td { border-bottom: none; }

    /* ── Vocab grid (4 cards) ── */
    .vocab-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
      margin: var(--space-5) 0;
    }
    @media (max-width: 700px) { .vocab-grid { grid-template-columns: 1fr; } }
    .vocab-card {
      background: var(--surface-2);
      border: 1px solid var(--border-subtle);
      border-top: 3px solid var(--standard-3-colour, var(--accent));
      border-radius: var(--radius-md);
      padding: var(--space-4) var(--space-5);
    }
    .vocab-card h4 {
      margin: 0 0 var(--space-2) 0;
      color: var(--standard-3-colour, var(--accent));
      font-size: var(--text-base);
    }
    .vocab-card p { font-size: var(--text-sm); margin-bottom: 0; }

    /* ── Info cards row (3 cards) ── */
    .info-cards-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin: var(--space-5) 0;
    }
    @media (max-width: 800px) { .info-cards-row { grid-template-columns: 1fr; } }
    .info-card {
      background: var(--surface-2);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: var(--space-4) var(--space-5);
    }
    .info-card h4 {
      margin: 0 0 var(--space-2) 0;
      font-size: var(--text-base);
    }
    .info-card p { font-size: var(--text-sm); margin-bottom: 0; }
    .info-card--anticipation { border-top: 3px solid var(--accent); }
    .info-card--anticipation h4 { color: var(--accent); }
    .info-card--coordination { border-top: 3px solid var(--standard-3-colour, var(--accent)); }
    .info-card--coordination h4 { color: var(--standard-3-colour, var(--accent)); }
    .info-card--robustness { border-top: 3px solid var(--info); }
    .info-card--robustness h4 { color: var(--info); }

    /* ── Video embeds ── */
    .video-stack {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin: var(--space-4) 0;
    }
    .video-wrapper {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%;
      background: var(--surface-2);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .video-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .video-caption {
      font-size: var(--text-sm);
      color: var(--text-muted);
      margin-bottom: var(--space-3) !important;
    }

    /* ── Check yourself ── */
    .check-grid {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin: var(--space-4) 0;
    }
    .check-card {
      background: var(--surface-2);
      border: 1px solid var(--border-subtle);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius-md);
      padding: var(--space-3) var(--space-4);
    }
    .check-card summary {
      cursor: pointer;
      font-weight: var(--weight-semibold);
      color: var(--text-primary);
      font-size: var(--text-sm);
      list-style: none;
    }
    .check-card summary::-webkit-details-marker { display: none; }
    .check-card summary::before {
      content: '▸';
      display: inline-block;
      margin-right: var(--space-2);
      color: var(--accent);
      transition: transform var(--transition-fast);
    }
    .check-card[open] summary::before { transform: rotate(90deg); }
    .check-card p {
      margin-top: var(--space-3);
      padding-top: var(--space-3);
      border-top: 1px dashed var(--border-subtle);
      font-size: var(--text-sm);
      color: var(--text-secondary);
    }

    /* ── Feature list ── */
    .feature-list {
      list-style: none !important;
      padding: 0 !important;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .feature-list li {
      position: relative;
      padding-left: var(--space-5);
      font-size: var(--text-base);
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
    }
    .feature-list li::before {
      content: '→';
      position: absolute;
      left: 0;
      top: 0;
      color: var(--standard-3-colour, var(--accent));
      font-weight: bold;
    }

    /* ── Preview-list block ── */
    .preview-list {
      background: var(--surface-2);
      border-radius: var(--radius-md);
      padding: var(--space-4) var(--space-5);
      margin-top: var(--space-4);
    }
    .preview-list p { margin-bottom: var(--space-3); color: var(--text-primary); }

    /* ─────────────────────────────────────────────────────────────────────
       SIDEBAR
       ───────────────────────────────────────────────────────────────────── */
    .week-sidebar {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      position: sticky;
      top: calc(var(--space-8) + 60px);
    }
    .sidebar-card {
      background: var(--surface-1);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
    }
    .sidebar-card h3 {
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      font-family: var(--font-display);
      color: var(--text-primary);
      margin-bottom: var(--space-4);
    }
    .sidebar-card--objectives { border-top: 3px solid var(--standard-3-colour, var(--accent)); }
    .sidebar-card--connection { border-top: 3px solid var(--accent); }

    .objectives-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .objectives-list li {
      position: relative;
      padding-left: var(--space-5);
      font-size: var(--text-sm);
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
    }
    .objectives-list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.5em;
      width: 8px;
      height: 8px;
      border: 1.5px solid var(--standard-3-colour, var(--accent));
      border-radius: 2px;
    }

    .sidebar-text {
      font-size: var(--text-sm);
      color: var(--text-secondary);
      margin-bottom: var(--space-2);
    }
    .sidebar-text--highlight {
      background: var(--surface-2);
      padding: var(--space-3);
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--accent);
      margin-top: var(--space-3);
    }

    .vocab-list {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
    }
    .vocab-list dt {
      font-weight: var(--weight-semibold);
      color: var(--text-primary);
      margin-top: var(--space-3);
    }
    .vocab-list dt:first-of-type { margin-top: 0; }
    .vocab-list dd { margin: 2px 0 0 0; }

    .scipad-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: var(--text-sm);
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
    }
    .scipad-list li { margin-bottom: var(--space-2); }

    .how-to-list {
      padding-left: var(--space-5);
      margin: 0;
      font-size: var(--text-sm);
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
    }
    .how-to-list li { margin-bottom: var(--space-2); }
  </style>


  <!-- ====================================================================
       Scripts
       ==================================================================== -->
  <script is:inline>
    /* IntersectionObserver — fade-in-up animations */
    (function initObserver() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.fade-in-up').forEach((el) => observer.observe(el));
    })();
  </script>

</BaseLayout>
