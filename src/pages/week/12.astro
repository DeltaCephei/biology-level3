---
/* ==========================================================================
   Week 12 — Internal Wrap-Up & Coastal Seas
   Term 2 (Wks 11–21)

   Lessons 1, 2 & 4 (joint): Homeostasis internal — finish, polish, push for
                              Excellence, or start AS 91603 revision.
   Lesson 3:                  Our Planet S1 E4 "Coastal Seas" — pre-camp
                              orientation for the Mistletoe Bay biocamp.
   ========================================================================== */

import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Week 12: Internal Wrap-Up & Coastal Seas — Dr Eliot's Level 3 Biology">

  <div class="week-page">

    <!-- ====================================================================
         Week Header
         ==================================================================== -->
    <header class="week-header fade-in-up">
      <div class="week-header__meta">
        <a href={base || "/"} class="back-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to Dashboard
        </a>
        <span class="term-badge term-badge--t2">Term 2</span>
      </div>

      <div class="week-header__title-row">
        <span class="week-number">Week 12</span>
        <h1 class="week-title">Internal Wrap-Up &amp; Coastal Seas</h1>
      </div>

      <div class="week-header__badges">
        <span class="badge badge--standard">AS 91604</span>
        <span class="badge badge--internal">Internal</span>
        <span class="badge badge--desc">Deadline was Fri 8 May, 23:59. Extensions on request.</span>
      </div>
    </header>


    <!-- ====================================================================
         Quick Navigation
         ==================================================================== -->
    <nav class="week-nav fade-in-up" aria-label="Page sections">
      <a href="#lessons-124" class="week-nav__link week-nav__link--active">Lessons 1, 2 &amp; 4: Internal Work Time</a>
      <a href="#lesson-3" class="week-nav__link">Lesson 3: Our Planet &mdash; Coastal Seas</a>
    </nav>


    <!-- ====================================================================
         Two-Column Layout
         ==================================================================== -->
    <div class="week-layout">

      <!-- ================================================================
           Main Content
           ================================================================ -->
      <main class="week-main">


        <!-- ——————————————————————————————————————————————————————————————
             Lessons 1, 2 & 4 (joint): Internal Work Time
             —————————————————————————————————————————————————————————————— -->
        <section id="lessons-124" class="content-section fade-in-up">
          <nav class="lesson-inline-nav" aria-label="Lesson navigation">
            <span class="lesson-inline-nav__current">Lessons 1, 2 &amp; 4 of 4</span>
            <a href="#lesson-3" class="lesson-inline-nav__link lesson-inline-nav__link--next">
              Lesson 3: Coastal Seas
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </nav>

          <h2>Lessons 1, 2 &amp; 4: Internal Work Time</h2>

          <p class="section-intro">
            The AS 91604 internal deadline was <strong>Friday 8 May, 23:59</strong>. Three of
            this week's lessons are reserved as work time so everyone has a clean run at it.
            What you do with the time depends on where you are.
          </p>


          <!-- ── Three lanes ── -->
          <h3>Three Lanes &mdash; Pick Yours</h3>

          <div class="lanes-grid">

            <div class="lane-card lane-card--submitted">
              <h4>1. Submitted on time</h4>
              <p>
                Brilliant. This time is yours to push for Excellence or to start AS 91603
                revision.
              </p>
              <ul>
                <li>Reread your Part D options. Is your strongest one really linked back to your specific system, not just &ldquo;natural selection in general&rdquo;?</li>
                <li>If you ticked off only two Part D options, write the third. Examiners use your strongest, so a third attempt is free upside.</li>
                <li>Or shift gears: open your Week 5 / Week 6 notes (animal responses, migration) and start the AS 91603 retrieval ladder. Week 13 begins with a paper recall on those topics, so a head start helps.</li>
              </ul>
            </div>

            <div class="lane-card lane-card--extension">
              <h4>2. Agreed extension</h4>
              <p>
                If you have an extension agreed with Dr Eliot, the new deadline is
                <strong>23:59 on the Friday you've agreed</strong>. Default for this week is
                Friday 15 May.
              </p>
              <ul>
                <li>Heads-down work time. Open your shared doc, open the assessment template in Teams, write.</li>
                <li>Same Mahi Mode Level 2 rules apply: AI for research, brainstorming, and checking understanding only. No AI-written content.</li>
                <li>Use the textbook site (Week 11 has the access steps), Week 9, and Week 10 for your reference material.</li>
              </ul>
            </div>

            <div class="lane-card lane-card--late">
              <h4>3. No submission, no extension yet</h4>
              <p>
                Talk to me first. Send a Teams message before Lesson 1 with one sentence on
                where you are and what you need.
              </p>
              <ul>
                <li>An extension is almost always possible at MBC, but it has to be agreed and logged. Don't just turn up and hope.</li>
                <li>Once we've agreed a date, you join Lane 2 above.</li>
              </ul>
            </div>

          </div>


          <!-- ── A sensible work order if you're still writing ── -->
          <h3>A Sensible Order If You're Still Writing</h3>

          <div class="workflow-steps">

            <div class="workflow-step">
              <span class="workflow-step__num">1</span>
              <div>
                <h4>Re-read Part A and tighten the components (15 min)</h4>
                <p>
                  Set point, receptors, control centre, effectors, response. Are they all
                  named specifically? &ldquo;A sensor in the skin&rdquo; is not enough.
                  &ldquo;Peripheral thermoreceptors in the dermis&rdquo; is.
                </p>
              </div>
            </div>

            <div class="workflow-step">
              <span class="workflow-step__num">2</span>
              <div>
                <h4>Sketch the negative-feedback loop both ways (20 min)</h4>
                <p>
                  Pen and paper first. Variable rises, variable falls. Walk through both
                  directions of Part B. Then write it.
                </p>
              </div>
            </div>

            <div class="workflow-step">
              <span class="workflow-step__num">3</span>
              <div>
                <h4>Lock the Part C disruption (30 min)</h4>
                <p>
                  Pick one specific extreme disruption. Describe what happens, how the body
                  responds, and how balance is restored. Stay focused on the biology.
                </p>
              </div>
            </div>

            <div class="workflow-step">
              <span class="workflow-step__num">4</span>
              <div>
                <h4>Part D &mdash; aim for at least two (rest of the time)</h4>
                <p>
                  Adaptive advantage, biochemistry, or environmental breakdown. Pick the
                  two you can link most clearly back to your system. The strongest scores.
                </p>
              </div>
            </div>

          </div>

          <div class="connection-box">
            <h4>The Mahi Mode Reminder</h4>
            <p>
              <strong>Level 2 &mdash; AI to start, not to finish.</strong> Research, plan,
              check facts. Then write in your own voice. The AI Use Declaration at the end
              of the assessment is non-optional if you used AI at any point.
            </p>
          </div>

        </section>


        <!-- ——————————————————————————————————————————————————————————————
             Lesson 3: Our Planet S1 E4 — Coastal Seas
             —————————————————————————————————————————————————————————————— -->
        <section id="lesson-3" class="content-section fade-in-up">
          <nav class="lesson-inline-nav" aria-label="Lesson navigation">
            <a href="#lessons-124" class="lesson-inline-nav__link lesson-inline-nav__link--prev">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Back to internal work time
            </a>
            <span class="lesson-inline-nav__current">Lesson 3 of 4</span>
          </nav>

          <h2>Lesson 3: Our Planet S1 E4 &mdash; Coastal Seas</h2>

          <p class="section-intro">
            One full lesson watching <em>Our Planet</em> Series 1 Episode 4,
            <em>Coastal Seas</em>. Episode runs about 50 minutes. This is deliberate
            scene-setting for the Mistletoe Bay biocamp later in Term 2.
          </p>

          <h3>Why This Episode</h3>

          <p>
            Mistletoe Bay sits in the Marlborough Sounds. You'll be looking at temperate-reef
            organisms, kelp, herring spawn, and the full coastal-zonation story. <em>Coastal
            Seas</em> covers the global version of the same biology: kelp forests as
            ecosystem engineers, sea otters as a keystone species, herring-spawn pulses,
            dolphin super-pods, and what happens when those systems are pushed too hard.
            Watch it now and the camp will land much harder when we get there.
          </p>

          <h3>Active Viewing &mdash; Keep These Notes</h3>

          <p>
            Open a doc or grab a fresh page. Answer these as you watch. Bullet points are
            fine; full sentences are better. Keep what you write &mdash; we'll come back to
            it before camp.
          </p>

          <ol class="step-list">
            <li>
              <strong>Keystone species.</strong> Name a keystone species shown in the
              episode. Explain in two or three sentences how its presence shapes the wider
              community, and what disappears when it's removed.
            </li>
            <li>
              <strong>A cyclical or seasonal response.</strong> Pick one event in the
              episode that is triggered by season, light, or temperature (herring spawn,
              sardine run, coral spawning, etc.). Identify the biotic and abiotic triggers.
              This is direct AS 91603 territory.
            </li>
            <li>
              <strong>A threat to coastal ecosystems.</strong> The episode covers several.
              Pick one. Predict what we might see, or stop seeing, at Mistletoe Bay if a
              similar pressure was acting in the Marlborough Sounds.
            </li>
            <li>
              <strong>Behaviour that fits Weeks 5&ndash;6.</strong> Find one species
              behaviour that fits a category from earlier this year &mdash; taxis, kinesis,
              migration, or social signalling like the waggle dance. Explain the fit.
            </li>
          </ol>

          <div class="exam-tip">
            <h4>Linking Forward to Mistletoe Bay</h4>
            <p>
              Most of what we'll see at Mistletoe Bay is temperate-reef biology &mdash; not
              tropical coral, but the same logic: light gradients with depth, zonation,
              filter feeders, kelp as habitat-former, top-down vs bottom-up control. If you
              come out of this episode understanding why removing one species can collapse a
              kelp forest, you will get far more out of the camp.
            </p>
          </div>

          <h3>Episode Access</h3>

          <p>
            <em>Our Planet</em> Series 1 Episode 4 <em>Coastal Seas</em> is on Netflix. We'll
            stream in class on the school account. If the school Wi-Fi is unreliable on the
            day, the reliever or I can download the episode in advance &mdash; flag it
            ahead of the lesson rather than on the day.
          </p>

        </section>

      </main>


      <!-- ================================================================
           Sidebar
           ================================================================ -->
      <aside class="week-sidebar">

        <!-- Deadline card -->
        <div class="sidebar-card sidebar-card--deadline fade-in-up">
          <h3>Internal Deadline</h3>
          <p class="sidebar-deadline">Fri 8 May 2026</p>
          <p class="sidebar-deadline-time">23:59 &bull; via Teams</p>
          <p class="sidebar-text">
            Original deadline. Extensions are individual &mdash; message me on Teams before
            Lesson 1 if you need one and we'll agree a new Friday.
          </p>
        </div>

        <!-- Learning Objectives -->
        <div class="sidebar-card sidebar-card--objectives fade-in-up">
          <h3>This Week You Will</h3>
          <ul class="objectives-list">
            <li>Submit, polish, or push the AS 91604 internal toward Excellence</li>
            <li>Watch <em>Our Planet</em> S1 E4 &mdash; Coastal Seas as Mistletoe Bay pre-reading</li>
            <li>Identify a keystone species, a seasonal trigger, a threat, and a Wk 5&ndash;6 behaviour from the episode</li>
            <li>Begin AS 91603 revision if you've already submitted</li>
          </ul>
        </div>

        <!-- Quick Links -->
        <div class="sidebar-card fade-in-up">
          <h3>Quick Links</h3>
          <div class="sidebar-links">
            <a href={`${base}/week/11`} class="sidebar-link">
              <span class="sidebar-link__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9l-7-7z" stroke="var(--accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M13 2v7h7" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Week 11 &mdash; the writing brief</span>
            </a>
            <a href={`${base}/week/13`} class="sidebar-link">
              <span class="sidebar-link__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke="var(--fluoro-cyan)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Next: Week 13 &mdash; paper retrieval</span>
            </a>
          </div>
        </div>

        <!-- Reference Material -->
        <div class="sidebar-card fade-in-up">
          <h3>If You're Already Revising</h3>
          <div class="sidebar-links">
            <a href={`${base}/week/3`} class="sidebar-link">
              <span class="sidebar-link__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9l-7-7z" stroke="var(--text-muted)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Wk 3 &mdash; Simple animal responses</span>
            </a>
            <a href={`${base}/week/4`} class="sidebar-link">
              <span class="sidebar-link__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9l-7-7z" stroke="var(--text-muted)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Wk 4 &mdash; Taxes, kineses, pheromones</span>
            </a>
            <a href={`${base}/week/5`} class="sidebar-link">
              <span class="sidebar-link__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9l-7-7z" stroke="var(--text-muted)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Wk 5 &mdash; Waggle dance, homing</span>
            </a>
            <a href={`${base}/week/6`} class="sidebar-link">
              <span class="sidebar-link__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9l-7-7z" stroke="var(--text-muted)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>Wk 6 &mdash; Migration physiology</span>
            </a>
          </div>
        </div>

        <!-- Pre-camp note -->
        <div class="sidebar-card sidebar-card--connection fade-in-up">
          <h3>Mistletoe Bay &mdash; What To Expect</h3>
          <p class="sidebar-text">
            Temperate-reef biology in the Marlborough Sounds. Kelp, zonation, filter
            feeders, top-down vs bottom-up control. <em>Coastal Seas</em> is the global
            version of the same biology.
          </p>
          <p class="sidebar-text sidebar-text--highlight">
            Keep your viewing notes &mdash; we'll come back to them before camp.
          </p>
        </div>

      </aside>

    </div><!-- /week-layout -->

  </div><!-- /week-page -->


  <!-- ====================================================================
       Styles
       ==================================================================== -->
  <style>
    /* ==========================================================================
       Week 12 Page Styles — Internal Wrap-Up & Coastal Seas
       Shares the conventions of Weeks 7–11.
       ========================================================================== */

    .week-page {
      max-width: 1120px;
      margin: 0 auto;
      padding: var(--space-6) var(--space-5) var(--space-8);
    }

    .fade-in-up {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.6s cubic-bezier(0.23, 1, 0.32, 1),
        transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .fade-in-up.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── Week Header ── */
    .week-header {
      margin-bottom: var(--space-6);
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--border-subtle);
    }
    .week-header__meta {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-sm);
      color: var(--text-secondary);
      text-decoration: none;
      transition: color var(--transition-fast);
    }
    .back-link:hover { color: var(--accent); }
    .term-badge {
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
      font-family: var(--font-display);
      color: var(--text-muted);
      background: var(--surface-2);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
    }
    /* Term 2 tinted badge — subtle blue signal */
    .term-badge--t2 {
      background: rgba(9, 132, 227, 0.15);
      color: #0984e3;
    }
    .week-header__title-row { margin-bottom: var(--space-3); }
    .week-number {
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-sm);
      font-weight: var(--weight-semibold);
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: var(--space-2);
    }
    .week-title {
      font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
      font-weight: var(--weight-bold);
      line-height: var(--leading-tight);
    }
    .week-header__badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
    }
    .badge {
      display: inline-flex;
      align-items: center;
      padding: var(--space-1) var(--space-3);
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
      font-family: var(--font-display);
      border-radius: var(--radius-full);
      line-height: 1;
      white-space: nowrap;
    }
    .badge--standard { background: rgba(0, 255, 136, 0.1); color: var(--accent); }
    .badge--internal { background: rgba(255, 180, 0, 0.12); color: #fbbf24; }
    .badge--desc {
      background: transparent;
      color: var(--text-muted);
      padding: 0;
      font-weight: var(--weight-normal);
      font-family: var(--font-body);
      font-size: var(--text-sm);
    }

    /* ── Quick Navigation ── */
    .week-nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-6);
      padding: var(--space-3) var(--space-4);
      background: var(--surface-1);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
    }
    .week-nav__link {
      padding: var(--space-2) var(--space-4);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: all var(--transition-fast);
    }
    .week-nav__link:hover { background: var(--surface-2); color: var(--text-primary); }
    .week-nav__link--active { background: var(--surface-2); color: var(--accent); }

    /* ── Two-Column Layout ── */
    .week-layout {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: var(--space-6);
      align-items: start;
    }
    @media (max-width: 900px) {
      .week-layout { grid-template-columns: 1fr; }
    }

    /* ── Main Content ── */
    .week-main {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }
    .content-section {
      background: var(--surface-1);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
    }
    .content-section h2 {
      font-size: var(--text-xl);
      margin-bottom: var(--space-2);
      color: var(--accent);
    }
    .content-section h3 {
      font-size: var(--text-lg);
      font-weight: var(--weight-bold);
      font-family: var(--font-display);
      color: var(--text-primary);
      margin-top: var(--space-6);
      margin-bottom: var(--space-3);
    }
    .content-section h4 {
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      color: var(--text-primary);
