      margin-bottom: var(--space-2);
    }
    .content-section a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px dotted var(--accent);
      transition: opacity var(--transition-fast);
    }
    .content-section a:hover { opacity: 0.75; }

    /* ── Lesson Inline Nav ── */
    .lesson-inline-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-5);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--border-subtle);
    }
    .lesson-inline-nav__current {
      font-size: var(--text-xs);
      font-family: var(--font-mono);
      color: var(--text-muted);
    }
    .lesson-inline-nav__link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      color: var(--accent);
      text-decoration: none;
      transition: opacity var(--transition-fast);
      border-bottom: none;
    }
    .lesson-inline-nav__link:hover { opacity: 0.8; }

    /* ── Lanes grid (three-lane work-mode card row) ── */
    .lanes-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin: var(--space-5) 0;
    }
    @media (max-width: 800px) {
      .lanes-grid { grid-template-columns: 1fr; }
    }
    .lane-card {
      background: var(--surface-2);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      display: flex;
      flex-direction: column;
    }
    .lane-card--submitted { border-top: 3px solid var(--accent); }
    .lane-card--extension { border-top: 3px solid var(--fluoro-cyan); }
    .lane-card--late { border-top: 3px solid var(--fluoro-pink); }
    .lane-card h4 {
      margin-top: 0;
      margin-bottom: var(--space-3);
      font-size: var(--text-base);
    }
    .lane-card--submitted h4 { color: var(--accent); }
    .lane-card--extension h4 { color: var(--fluoro-cyan); }
    .lane-card--late h4 { color: var(--fluoro-pink); }
    .lane-card p { font-size: var(--text-sm); margin-bottom: var(--space-3); }
    .lane-card ul { font-size: var(--text-sm); padding-left: var(--space-5); margin-bottom: 0; }

    /* ── Connection Box ── */
    .connection-box {
      background: var(--surface-2);
      border: 1px solid var(--accent);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      margin: var(--space-5) 0;
    }
    .connection-box h4 {
      font-family: var(--font-display);
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      color: var(--accent);
      margin-bottom: var(--space-3);
      margin-top: 0;
    }

    /* ── Exam Tip ── */
    .exam-tip {
      background: rgba(9, 132, 227, 0.06);
      border: 1px solid rgba(9, 132, 227, 0.2);
      border-radius: var(--radius-md);
      padding: var(--space-5);
      margin: var(--space-4) 0;
    }
    .exam-tip h4 {
      font-size: var(--text-base);
      font-weight: var(--weight-semibold);
      color: #0984e3;
      margin-bottom: var(--space-3);
      margin-top: 0;
    }
    .exam-tip p { font-size: var(--text-sm); }

    /* ── Step list (instructions) ── */
    .step-list {
      list-style: none !important;
      counter-reset: step-counter;
      padding-left: 0 !important;
      margin: var(--space-4) 0 !important;
    }
    .step-list li {
      counter-increment: step-counter;
      position: relative;
      padding-left: calc(var(--space-5) + 28px);
      font-size: var(--text-sm);
      margin-bottom: var(--space-3);
    }
    .step-list li::before {
      content: counter(step-counter);
      position: absolute;
      left: 0;
      top: 0;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent);
      color: var(--surface-0);
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-sm);
      border-radius: var(--radius-full);
    }

    /* ── Workflow steps ── */
    .workflow-steps {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin: var(--space-5) 0;
    }
    .workflow-step {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: var(--space-4);
      align-items: start;
      background: var(--surface-2);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: var(--space-4);
    }
    .workflow-step__num {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--fluoro-cyan);
      color: var(--surface-0);
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      border-radius: var(--radius-full);
    }
    .workflow-step h4 {
      margin: 0 0 var(--space-2) 0 !important;
      font-size: var(--text-base) !important;
    }
    .workflow-step p {
      font-size: var(--text-sm) !important;
      margin-bottom: 0 !important;
    }


    /* ─────────────────────────────────────────────────────────────────────
       SIDEBAR
       ───────────────────────────────────────────────────────────────────── */
    .week-sidebar {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      position: sticky;
      top: calc(var(--space-8) + 60px);
    }
    .sidebar-card {
      background: var(--surface-1);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
    }
    .sidebar-card h3 {
      font-size: var(--text-base);
      font-weight: var(--weight-bold);
      font-family: var(--font-display);
      color: var(--text-primary);
      margin-bottom: var(--space-4);
    }
    .sidebar-card--objectives { border-top: 3px solid var(--accent); }
    .sidebar-card--connection { border-top: 3px solid var(--fluoro-cyan); }
    .sidebar-card--deadline { border-top: 3px solid #fbbf24; }

    .sidebar-deadline {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: var(--weight-bold);
      color: #fbbf24;
      margin-bottom: var(--space-1);
    }
    .sidebar-deadline-time {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--text-secondary);
      margin-bottom: var(--space-3);
    }

    .objectives-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .objectives-list li {
      position: relative;
      padding-left: var(--space-5);
      font-size: var(--text-sm);
      color: var(--text-secondary);
      line-height: var(--leading-relaxed);
    }
    .objectives-list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.5em;
      width: 8px;
      height: 8px;
      border: 1.5px solid var(--accent);
      border-radius: 2px;
    }

    .sidebar-links {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      text-decoration: none;
      color: var(--text-secondary);
      font-size: var(--text-sm);
      transition: all var(--transition-fast);
    }
    .sidebar-link:hover { background: var(--surface-2); color: var(--text-primary); }
    .sidebar-link__icon { flex-shrink: 0; }

    .sidebar-text {
      font-size: var(--text-sm);
      color: var(--text-secondary);
      margin-bottom: var(--space-2);
    }
    .sidebar-text--highlight {
      background: var(--surface-2);
      padding: var(--space-3);
      border-radius: var(--radius-sm);
      border-left: 3px solid var(--fluoro-cyan);
      margin-top: var(--space-3);
    }
  </style>


  <!-- ====================================================================
       Scripts
       ==================================================================== -->
  <script is:inline>

    /* IntersectionObserver — Fade-in-up animations */
    (function initObserver() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.fade-in-up').forEach((el) => observer.observe(el));
    })();

  </script>

</BaseLayout>
